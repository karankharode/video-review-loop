{
  "name": "video-loop-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Kallaway-style captions and graphics for the video loop. Driven by the linked variation's beats file; renders a flat preview plus transparent overlays for DaVinci Resolve.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "preview": "remotion render src/index.ts PlaceholderCut out/preview.mp4",
    "captions": "remotion render src/index.ts CaptionsAlpha out/captions_alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "graphics": "remotion render src/index.ts GraphicsAlpha out/graphics_alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
